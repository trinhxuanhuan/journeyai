# Copy file này thành .env và điền giá trị thật — .env KHÔNG commit lên Git.

# Dùng chung cho Auth Service (ký JWT) và AI Service (tự verify JWT)
# — AI_PIPELINE.md §2.3.1
JWT_SIGNING_SECRET=change_me_to_a_long_random_string

# Hạ tầng local. Trên staging phải thay password và giữ INFRA_BIND_HOST ở
# loopback để database/message broker không bị công khai ra Internet.
POSTGRES_USER=journeyai
POSTGRES_PASSWORD=journeyai_dev_password
MONGO_USERNAME=journeyai
MONGO_PASSWORD=journeyai_dev_password
TOUR_MONGO_URI=mongodb://journeyai:journeyai_dev_password@mongodb:27017/tour_service_db?authSource=admin
AI_MONGO_URI=mongodb://journeyai:journeyai_dev_password@mongodb:27017
INFRA_BIND_HOST=127.0.0.1
GATEWAY_BIND_HOST=0.0.0.0
GATEWAY_PORT=8090
CORS_ALLOWED_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGIN_ALT=http://127.0.0.1:3000

# Gemini Pro API key — AI_PIPELINE.md §4.4 (dùng ở Sprint 7-8, chưa cần Sprint 0)
GEMINI_API_KEY=

# VNPay — dùng ở Sprint 4-6, chưa cần Sprint 0
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8090/v1/payments/vnpay-return

# Email giao dịch (OTP + thông báo booking/payment). Mặc định tắt để local/CI
# không phụ thuộc SMTP. Với Gmail, SMTP_PASSWORD nên là App Password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@vietkhampha.vn
FRONTEND_BASE_URL=http://localhost:3000
