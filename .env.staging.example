# Sao chép thành một file nằm ngoài Git, ví dụ /opt/viet-kham-pha/staging.env.
# Không dùng nguyên các giá trị REPLACE_ME khi triển khai.

JWT_SIGNING_SECRET=REPLACE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

POSTGRES_USER=journeyai
POSTGRES_PASSWORD=REPLACE_ME_WITH_A_STRONG_POSTGRES_PASSWORD
MONGO_USERNAME=journeyai
MONGO_PASSWORD=REPLACE_ME_WITH_A_STRONG_MONGO_PASSWORD
# Password trong URI phải được URL-encode nếu chứa ký tự đặc biệt.
TOUR_MONGO_URI=mongodb://journeyai:REPLACE_ME_URL_ENCODED@mongodb:27017/tour_service_db?authSource=admin
AI_MONGO_URI=mongodb://journeyai:REPLACE_ME_URL_ENCODED@mongodb:27017

# Chỉ reverse proxy trên cùng máy được truy cập Gateway và hạ tầng.
INFRA_BIND_HOST=127.0.0.1
GATEWAY_BIND_HOST=127.0.0.1
GATEWAY_PORT=8090

# Artifact bất biến do GitHub Actions phát hành. Giữ owner ở dạng chữ thường.
CONTAINER_REGISTRY=ghcr.io
CONTAINER_IMAGE_OWNER=trinhxuanhuan
RELEASE_VERSION=sha-REPLACE_ME_WITH_12_COMMIT_CHARACTERS

FRONTEND_BASE_URL=https://staging.vietkhampha.vn
CORS_ALLOWED_ORIGIN=https://staging.vietkhampha.vn
CORS_ALLOWED_ORIGIN_ALT=https://staging.vietkhampha.vn

EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
SMTP_FROM=no-reply@vietkhampha.vn

GEMINI_API_KEY=REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

VNPAY_TMN_CODE=REPLACE_ME_WITH_SANDBOX_TMN_CODE
VNPAY_HASH_SECRET=REPLACE_ME_WITH_SANDBOX_HASH_SECRET
VNPAY_RETURN_URL=https://api-staging.vietkhampha.vn/v1/payments/vnpay-return

NOTIFICATION_EMAIL_DISPATCH_DELAY_MS=5000
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_INBOX_RETRY_DELAY_MS=10000
NOTIFICATION_INBOX_MAX_ATTEMPTS=10
DEPARTURE_REMINDER_ENABLED=true
DEPARTURE_REMINDER_DAYS_BEFORE=1
DEPARTURE_REMINDER_CRON=0 0 8 * * *
